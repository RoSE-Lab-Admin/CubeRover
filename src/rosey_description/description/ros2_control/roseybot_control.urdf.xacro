<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="connect_joint" params="prefix">
        <joint name="${prefix}_wheel_joint">
            <command_interface name="velocity"/>
            <!-- RoseyBotSystemHardware expects exactly these six state
                 interfaces, with position first and velocity second. -->
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="current"/>
            <state_interface name="effort"/>
            <state_interface name="voltage"/>
            <state_interface name="pwm"/>
        </joint>
    </xacro:macro>

    <xacro:macro name="roseybot_ros2_control" params="use_mock_hardware">
        <ros2_control name="roseybot_teensy" type="system">

            <hardware>
                <xacro:if value="${use_mock_hardware}">
                    <plugin>mock_components/GenericSystem</plugin>
                    <param name="calculate_dynamics">true</param>
                </xacro:if>
                <xacro:unless value="${use_mock_hardware}">
                    <plugin>roseybot_arduino/RoseyBotSystemHardware</plugin>
                    <param name="baud">115200</param>
                    <param name="timeout_ms">150</param>
                    <param name="device">/dev/ttyACM0</param>
                    <param name="enc/rev">5281.1</param>
                    <!-- effort [N*m] = current [A] * torque_constant. Pooled fit of the
                         four characterized motors (same model/gearbox): 55 mA per kg*cm. -->
                    <param name="torque_constant">1.784</param>

                    <!-- safety_check tuning parameters -->
                    <param name="noise_floor_percent">2</param>
                    <param name="opposite_direction_ms">500</param>
                    <param name="max_velocity_percent">75</param>
                </xacro:unless>
            </hardware>

            <!-- Do not reorder: RoseyBotSystemHardware maps joints by index.
                 Telemetry index i is motor i+1 (FL, FR, BL, BR), and write()
                 sends joint 0 as the left command and joint 1 as the right. -->
            <xacro:connect_joint prefix="front_left"/>
            <xacro:connect_joint prefix="front_right"/>
            <xacro:connect_joint prefix="back_left"/>
            <xacro:connect_joint prefix="back_right"/>

        </ros2_control>
    </xacro:macro>

</robot>
