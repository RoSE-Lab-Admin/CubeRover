<?xml version="1.0"?>
<!-- RoseyBot Robot Description File

     Links, joints, and mass properties come from the SolidWorks to URDF
     exporter (URDF2 export). Frames follow REP-103/REP-105:
       - base_footprint is the root, on the ground plane below base_link.
       - base_footprint, imu_link, and camera_*_optical_link are virtual
         frames with no mass, inertia, or geometry.
       - All wheel joints rotate about +y, so a positive velocity drives the
         robot forward on both sides. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Virtual frame: no mass, inertia, or geometry. -->
  <link
    name="base_footprint" />
  <joint
    name="base_footprint_joint"
    type="fixed">
    <!-- base_footprint lies on the ground plane under base_link (150 mm
         effective wheel radius; the grousers sink into the terrain). -->
    <origin
      xyz="0 0 0.264385282852235"
      rpy="0 0 0" />
    <parent
      link="base_footprint" />
    <child
      link="base_link" />
    <axis
      xyz="0 0 0" />
  </joint>
  <link
    name="base_link">
    <inertial>
      <origin
        xyz="-0.0054525 0.0030219 -0.021701"
