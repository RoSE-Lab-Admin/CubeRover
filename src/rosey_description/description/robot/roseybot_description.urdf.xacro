  <joint name="base_footprint_joint" type="fixed">
    <!-- base_footprint lies on the ground plane under base_link -->
    <origin xyz="0 0 0.264385282852235" rpy="0 0 0" />
    <parent link="base_footprint" />
    <child link="base_link" />
  </joint>
