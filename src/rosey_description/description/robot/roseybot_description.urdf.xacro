        ixz="2.7978E-05"
        iyy="0.085655"
        iyz="2.5148E-06"
        izz="0.10185" />
    </inertial>
    <visual>
      <!-- SolidWorks exported base_link.STL relative to a frame 0.264385 m
           below base_link, so shift it back up into base_link. -->
      <origin
        xyz="0 0 -0.264385282852235"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://rosey_description/description/meshes/base_link.STL" />
      </geometry>
      <material
        name="base_link_material">
        <color
          rgba="0.75294 0.75294 0.75294 1" />
      </material>
    </visual>
    <collision>
      <!-- SolidWorks exported base_link.STL relative to a frame 0.264385 m
